---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const tools = (await getCollection('tools')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const getPostHref = (id: string) => `${baseUrl}/blog/${id}/`;
---

<BaseLayout
  title="OishiMugicha"
  description="小さなプログラムや実験を展示する個人ブログです。"
>
  <main>
    <h1>OishiMugicha</h1>

    <p>
      小さなプログラムや実験を展示する場所です。
    </p>

    <section>
      <h2>Projects</h2>

      {tools.map((tool) => (
        <article>
          <h3>{tool.data.title}</h3>
          <p>{tool.data.description}</p>

          <a href={tool.data.demoUrl}>
            Demo
          </a>

          <a href={tool.data.githubUrl}>
            GitHub
          </a>
        </article>
      ))}
    </section>

    <section>
      <h2>Blog</h2>

      {posts.map((post) => (
        <article>
          <h3>
            <a href={getPostHref(post.id)}>{post.data.title}</a>
          </h3>

          <p>{post.data.description}</p>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    margin: 0;
    font-family: system-ui, sans-serif;
    line-height: 1.7;
  }

  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  h1 {
    font-size: 2.5rem;
  }

  article {
    padding: 1.5rem;
    border: 1px solid #ddd;
    border-radius: 12px;
  }

  a {
    margin-right: 1rem;
  }
</style>
